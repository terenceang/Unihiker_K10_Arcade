"<!-- gamepad.html: Simple virtual gamepad for K10 WiFi receiver -->\n"
"<!DOCTYPE html>\n"
"<html lang=\"en\">\n"
"<head>\n"
"  <meta charset=\"UTF-8\">\n"
"  <title>K10 WiFi Gamepad</title>\n"
"  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
"  <style>\n"
"    body { background: #111; color: #fff; font-family: sans-serif; text-align: center; }\n"
"    .dpad, .buttons { display: inline-block; margin: 2em; }\n"
"    .dpad button, .buttons button { width: 60px; height: 60px; margin: 5px; font-size: 1.5em; border-radius: 50%; border: none; background: #333; color: #fff; }\n"
"    .dpad button:active, .buttons button:active { background: #0af; }\n"
"    .sticks { margin: 2em; }\n"
"    input[type=range] { width: 120px; }\n"
"  </style>\n"
"</head>\n"
"<body>\n"
"  <h1>K10 WiFi Gamepad</h1>\n"
"  <div class=\"dpad\">\n"
"    <div><button id=\"up\">▲</button></div>\n"
"    <div>\n"
"      <button id=\"left\">◀</button>\n"
"      <button id=\"center\">●</button>\n"
"      <button id=\"right\">▶</button>\n"
"    </div>\n"
"    <div><button id=\"down\">▼</button></div>\n"
"  </div>\n"
"  <div class=\"buttons\">\n"
"    <button id=\"a\">A</button>\n"
"    <button id=\"b\">B</button>\n"
"    <button id=\"start\">Start</button>\n"
"    <button id=\"coin\">Coin</button>\n"
"  </div>\n"
"  <div class=\"sticks\">\n"
"    <div>LX: <input type=\"range\" id=\"lx\" min=\"-128\" max=\"127\" value=\"0\"></div>\n"
"    <div>LY: <input type=\"range\" id=\"ly\" min=\"-128\" max=\"127\" value=\"0\"></div>\n"
"    <div>RX: <input type=\"range\" id=\"rx\" min=\"-128\" max=\"127\" value=\"0\"></div>\n"
"    <div>RY: <input type=\"range\" id=\"ry\" min=\"-128\" max=\"127\" value=\"0\"></div>\n"
"  </div>\n"
"  <script>\n"
"    // Button/hat bitmasks (must match k10_input.h)\n"
"    // A = FIRE (0x10), B = COIN (0x40), Start = START (0x20), Coin = EXTRA (0x80)\n"
"    const BTN_A = 0x10, BTN_B = 0x40, BTN_START = 0x20, BTN_COIN = 0x80;\n"
"    let buttons = 0, hat = 8, lx = 0, ly = 0, rx = 0, ry = 0;\n"
"    function send() {\n"
"      fetch('/gamepad', {\n"
"        method: 'POST',\n"
"        headers: { 'Content-Type': 'application/json' },\n"
"        body: JSON.stringify({ buttons, hat, lx, ly, rx, ry })\n"
"      });\n"
"    }\n"
"    // D-pad: only send on press\n"
"    document.getElementById('up').ontouchstart = () => { hat = 0; send(); };\n"
"    document.getElementById('down').ontouchstart = () => { hat = 4; send(); };\n"
"    document.getElementById('left').ontouchstart = () => { hat = 6; send(); };\n"
"    document.getElementById('right').ontouchstart = () => { hat = 2; send(); };\n"
"    document.getElementById('center').ontouchstart = () => { hat = 8; send(); };\n"
"    document.getElementById('up').ontouchend = document.getElementById('down').ontouchend =\n"
"    document.getElementById('left').ontouchend = document.getElementById('right').ontouchend =\n"
"    document.getElementById('center').ontouchend = () => { hat = 8; };\n"
"    // Buttons: only send on press\n"
"    function setBtn(id, mask) {\n"
"      const btn = document.getElementById(id);\n"
"      btn.ontouchstart = () => { buttons |= mask; send(); };\n"
"      btn.ontouchend = () => { buttons &= ~mask; };\n"
"    }\n"
"    setBtn('a', BTN_A); setBtn('b', BTN_B); setBtn('start', BTN_START); setBtn('coin', BTN_COIN);\n"
"    // Sticks: do not send on move\n"
"    ['lx','ly','rx','ry'].forEach(axis => {\n"
"      document.getElementById(axis).oninput = e => { window[axis] = parseInt(e.target.value); };\n"
"    });\n"
"  </script>\n"
"</body>\n"
"</html>\n"
