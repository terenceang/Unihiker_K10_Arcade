"<!-- gamepad.html: SNES-style virtual gamepad for K10 WiFi receiver -->\n"
"<!DOCTYPE html>\n"
"<html lang=\"en\">\n"
"<head>\n"
"  <meta charset=\"UTF-8\">\n"
"  <title>K10 WiFi Gamepad</title>\n"
"  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0\">\n"
"  <style>\n"
"    body { \n"
"      background: #111; \n"
"      color: #fff; \n"
"      font-family: sans-serif; \n"
"      margin: 0; \n"
"      padding: 0;\n"
"      user-select: none;\n"
"      -webkit-user-select: none;\n"
"      touch-action: none;\n"
"      overflow: hidden;\n"
"      width: 100vw;\n"
"      height: 100vh;\n"
"    }\n"
"\n"
"    /* Rotation container */\n"
"    .wrapper {\n"
"      position: fixed;\n"
"      top: 0;\n"
"      left: 0;\n"
"      width: 100vw;\n"
"      height: 100vh;\n"
"      display: flex;\n"
"      flex-direction: column;\n"
"      align-items: center;\n"
"      justify-content: center;\n"
"      box-sizing: border-box;\n"
"    }\n"
"\n"
"    @media screen and (orientation: portrait) {\n"
"      .wrapper {\n"
"        width: 100vh;\n"
"        height: 100vw;\n"
"        top: 50%;\n"
"        left: 50%;\n"
"        transform: translate(-50%, -50%) rotate(90deg);\n"
"      }\n"
"    }\n"
"\n"
"    .controller {\n"
"      display: flex;\n"
"      flex-direction: row;\n"
"      align-items: center;\n"
"      justify-content: space-between;\n"
"      width: 95%;\n"
"      max-width: 800px;\n"
"      height: 85%;\n"
"      max-height: 400px;\n"
"      background: #333;\n"
"      border-radius: 50px;\n"
"      padding: 20px;\n"
"      box-shadow: 0 0 20px rgba(0,0,0,0.5);\n"
"      border: 4px solid #444;\n"
"      box-sizing: border-box;\n"
"      position: relative;\n"
"    }\n"
"\n"
"    /* D-PAD (Left) */\n"
"    .left-section {\n"
"      flex: 1;\n"
"      display: flex;\n"
"      justify-content: center;\n"
"    }\n"
"    .dpad {\n"
"      display: grid;\n"
"      grid-template-areas: \n"
"        \". up .\"\n"
"        \"left center right\"\n"
"        \". down .\";\n"
"      gap: 2px;\n"
"    }\n"
"    .dpad button {\n"
"      width: 65px;\n"
"      height: 65px;\n"
"      background: #222;\n"
"      border: 2px solid #444;\n"
"      color: #fff;\n"
"      font-size: 1.5em;\n"
"      border-radius: 8px;\n"
"      outline: none;\n"
"      -webkit-tap-highlight-color: transparent;\n"
"    }\n"
"    #up    { grid-area: up; border-radius: 12px 12px 0 0; }\n"
"    #down  { grid-area: down; border-radius: 0 0 12px 12px; }\n"
"    #left  { grid-area: left; border-radius: 12px 0 0 12px; }\n"
"    #right { grid-area: right; border-radius: 0 12px 12px 0; }\n"
"    #center { grid-area: center; border-radius: 0; background: #222; }\n"
"\n"
"    /* START / SELECT (Center) */\n"
"    .center-section {\n"
"      display: flex;\n"
"      flex-direction: column;\n"
"      gap: 30px;\n"
"      padding: 0 20px;\n"
"    }\n"
"    .center-section button {\n"
"      width: 90px;\n"
"      height: 35px;\n"
"      background: #555;\n"
"      border: none;\n"
"      border-radius: 20px;\n"
"      color: #fff;\n"
"      font-size: 0.8em;\n"
"      font-weight: bold;\n"
"      transform: rotate(-15deg);\n"
"      outline: none;\n"
"      -webkit-tap-highlight-color: transparent;\n"
"    }\n"
"\n"
"    /* BUTTONS (Right) */\n"
"    .right-section {\n"
"      flex: 1;\n"
"      display: flex;\n"
"      justify-content: center;\n"
"    }\n"
"    .action-buttons {\n"
"      position: relative;\n"
"      width: 180px;\n"
"      height: 180px;\n"
"    }\n"
"    .action-buttons button {\n"
"      position: absolute;\n"
"      width: 85px;\n"
"      height: 85px;\n"
"      border-radius: 50%;\n"
"      border: none;\n"
"      font-size: 1.8em;\n"
"      font-weight: bold;\n"
"      color: #fff;\n"
"      box-shadow: 2px 4px 0 rgba(0,0,0,0.3);\n"
"      outline: none;\n"
"      -webkit-tap-highlight-color: transparent;\n"
"    }\n"
"    #a { background: #e74c3c; bottom: 50px; right: 0; } /* Red */\n"
"    #b { background: #f1c40f; bottom: 0; left: 50px; } /* Yellow */\n"
"\n"
"    button:active {\n"
"      filter: brightness(1.5);\n"
"      transform: scale(0.95);\n"
"    }\n"
"    .center-section button:active {\n"
"        transform: rotate(-15deg) scale(0.95);\n"
"    }\n"
"\n"
"    h1 {\n"
"      font-size: 1.2em;\n"
"      color: #666;\n"
"      margin: 0 0 10px 0;\n"
"      text-transform: uppercase;\n"
"      letter-spacing: 2px;\n"
"    }\n"
"\n"
"    /* Hide sticks */\n"
"    .sticks { display: none; }\n"
"  </style>\n"
"</head>\n"
"<body>\n"
"  <div class=\"wrapper\">\n"
"    <h1>K10 Arcade System</h1>\n"
"    <div class=\"controller\">\n"
"      <!-- D-PAD -->\n"
"      <div class=\"left-section\">\n"
"        <div class=\"dpad\">\n"
"          <button id=\"up\">▲</button>\n"
"          <button id=\"left\">◀</button>\n"
"          <button id=\"center\">●</button>\n"
"          <button id=\"right\">▶</button>\n"
"          <button id=\"down\">▼</button>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <!-- START / COIN -->\n"
"      <div class=\"center-section\">\n"
"        <button id=\"coin\">COIN</button>\n"
"        <button id=\"start\">START</button>\n"
"      </div>\n"
"\n"
"      <!-- ACTION BUTTONS -->\n"
"      <div class=\"right-section\">\n"
"        <div class=\"action-buttons\">\n"
"          <button id=\"a\">A</button>\n"
"          <button id=\"b\">B</button>\n"
"        </div>\n"
"      </div>\n"
"    </div>\n"
"\n"
"    <div class=\"sticks\">\n"
"      <input type=\"range\" id=\"lx\" min=\"-128\" max=\"127\" value=\"0\">\n"
"      <input type=\"range\" id=\"ly\" min=\"-128\" max=\"127\" value=\"0\">\n"
"      <input type=\"range\" id=\"rx\" min=\"-128\" max=\"127\" value=\"0\">\n"
"      <input type=\"range\" id=\"ry\" min=\"-128\" max=\"127\" value=\"0\">\n"
"    </div>\n"
"  </div>\n"
"\n"
"  <script>\n"
"    // Button/hat bitmasks - AUTOMATICALLY INJECTED FROM k10_input.h\n"
"    const K10_BUTTON_LEFT = 0x01;\n"
"    const K10_BUTTON_RIGHT = 0x02;\n"
"    const K10_BUTTON_UP = 0x04;\n"
"    const K10_BUTTON_DOWN = 0x08;\n"
"    const K10_BUTTON_FIRE = 0x10;\n"
"    const K10_BUTTON_START = 0x20;\n"
"    const K10_BUTTON_COIN = 0x40;\n"
"    const K10_BUTTON_EXTRA = 0x80;\n"
"    const BTN_A = K10_BUTTON_FIRE, BTN_B = K10_BUTTON_COIN, BTN_START = K10_BUTTON_START, BTN_COIN = K10_BUTTON_COIN;\n"
"\n"
"    let buttons = 0, hat = 8, lx = 0, ly = 0, rx = 0, ry = 0;\n"
"    let lastSent = \"\";\n"
"\n"
"    function send(force = false) {\n"
"      const data = new Uint8Array(7);\n"
"      data[0] = buttons & 0xFF;\n"
"      data[1] = (buttons >> 8) & 0xFF;\n"
"      data[2] = hat;\n"
"      data[3] = lx;\n"
"      data[4] = ly;\n"
"      data[5] = rx;\n"
"      data[6] = ry;\n"
"\n"
"      const payload = data.join(',');\n"
"      if (!force && payload === lastSent) return;\n"
"      lastSent = payload;\n"
"      \n"
"      fetch('/gamepad', {\n"
"        method: 'POST',\n"
"        headers: { 'Content-Type': 'application/octet-stream' },\n"
"        body: data\n"
"      }).catch(err => console.error(\"Send error:\", err));\n"
"    }\n"
"\n"
"    function bind(id, onPress, onRelease) {\n"
"      const el = document.getElementById(id);\n"
"      if (!el) return;\n"
"      \n"
"      const start = (e) => { e.preventDefault(); onPress(); send(); };\n"
"      const end = (e) => { e.preventDefault(); onRelease(); send(); };\n"
"      \n"
"      el.addEventListener('touchstart', start, {passive: false});\n"
"      el.addEventListener('touchend', end, {passive: false});\n"
"      el.addEventListener('mousedown', start);\n"
"      el.addEventListener('mouseup', end);\n"
"      el.addEventListener('mouseleave', end);\n"
"    }\n"
"\n"
"    // D-pad\n"
"    bind('up',    () => { hat = 0; }, () => { hat = 8; });\n"
"    bind('down',  () => { hat = 4; }, () => { hat = 8; });\n"
"    bind('left',  () => { hat = 6; }, () => { hat = 8; });\n"
"    bind('right', () => { hat = 2; }, () => { hat = 8; });\n"
"    bind('center',() => { hat = 8; }, () => { hat = 8; });\n"
"\n"
"    // Buttons\n"
"    bind('a',     () => { buttons |= BTN_A; },     () => { buttons &= ~BTN_A; });\n"
"    bind('b',     () => { buttons |= BTN_B; },     () => { buttons &= ~BTN_B; });\n"
"    bind('start', () => { buttons |= BTN_START; }, () => { buttons &= ~BTN_START; });\n"
"    bind('coin',  () => { buttons |= BTN_COIN; },  () => { buttons &= ~BTN_COIN; });\n"
"\n"
"    // Sticks\n"
"    ['lx','ly','rx','ry'].forEach(axis => {\n"
"      const el = document.getElementById(axis);\n"
"      if (el) el.oninput = e => { \n"
"        window[axis] = parseInt(e.target.value); \n"
"        send();\n"
"      };\n"
"    });\n"
"\n"
"    window.oncontextmenu = function(event) {\n"
"        event.preventDefault();\n"
"        event.stopPropagation();\n"
"        return false;\n"
"    };\n"
"  </script>\n"
"</body>\n"
"</html>\n"
